# ── Bootstrap ──
PORT=3000

# CONFIG_MASTER_KEY encrypts API keys at rest inside runtime-config.json (AES-256-GCM).
# Recommended: set a fixed secret (32+ chars) so config stays portable across deploys.
# If omitted, a key is auto-generated on first boot and stored in config-master.key (gitignored).
CONFIG_MASTER_KEY=

# ── Optional boot fallbacks (manage these from the dashboard instead) ──
# The dashboard writes all runtime settings — including API keys, encrypted at rest —
# to runtime-config.json, which takes precedence over everything below.
# Values here are only used at boot when no runtime value exists (e.g. CI deploys).
# Custom providers add keys named CUSTOM_<PROVIDER_ID>_API_KEY the same way.

# AI Provider: gemini | openai | anthropic | nvidia | opencode
AI_PROVIDER=gemini
# AI Models (the listed default model per provider is used when AI_MODEL is empty):
# Gemini:  gemini-3.1-pro-preview (default), gemini-3-flash-preview, gemini-2.5-pro, gemini-2.5-flash
# OpenAI:  gpt-5.2 (default), gpt-5.2-codex, gpt-5, o4-mini, o3, gpt-4o, gpt-4o-mini
# Anthropic: claude-sonnet-4-20250514 (default), claude-opus-4-20250514, claude-3-5-sonnet-20241022
# NVIDIA:  qwen/qwen3.5-122b-a10b (default), deepseek-ai/deepseek-v4-pro, deepseek-ai/deepseek-v4-flash
# OpenCode Zen: deepseek-v4-flash (default), deepseek-v4-pro, glm-5.2, kimi-k3, minimax-m3, big-pickle, ...
AI_MODEL=gemini-3.1-pro-preview
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# OpenCode Zen key: https://opencode.ai/auth (base URL: https://opencode.ai/zen/v1)
OPENCODE_API_KEY=

# ── Persona Settings ──
PERSONA_NAME=Antigravity
HISTORY_LIMIT=30

# ── WhatsApp Gateway Options (OpenClaw style) ──
# DM Policy: open | allowlist | disabled
WHATSAPP_DM_POLICY=open
# Comma-separated list of numbers (e.g. 234812345678,234801111111)
WHATSAPP_ALLOW_FROM=
# Group Policy: enabled | disabled
WHATSAPP_GROUP_POLICY=disabled
# Read Receipts: true | false
WHATSAPP_READ_RECEIPTS=true
# Mention Trigger: only reply when message contains this (case-insensitive). Leave empty to reply to all.
WHATSAPP_MENTION_TRIGGER=@Mia